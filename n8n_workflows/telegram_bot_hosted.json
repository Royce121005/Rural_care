    {
      "parameters": {
        "jsCode": "const result = $input.item.json;\nconst chatId = $node[\"Handle Link Command\"].json.chatId;\n\nif (result.success) {\n  return {\n    chatId: chatId,\n    text: `\u2705 *Account Linked Successfully!*\\n\\nHi ${result.user_name || 'there'}! Your Telegram account has been linked to your RuralCare account.\\n\\nYou can now use:\\n/consultations - View your consultations\\n/prescriptions - Track prescriptions\\n/dashboard - Open your dashboard\\n\\nOr just send me any health question!`,\n    parse_mode: 'Markdown'\n  };\n} else {\n  const errorMsg = result.error || 'Unable to link account';\n  return {\n    chatId: chatId,\n    text: `\u274c *Linking Failed*\\n\\n${errorMsg}\\n\\nPlease make sure you entered the correct phone number registered with RuralCare.\\n\\nFormat: /link +919XXXXXXXXX\\n\\nIf you don't have an account, register at:\\nhttps://ruralcare-spx6.onrender.com/register`,\n    parse_mode: 'Markdown'\n  };\n}"
      },
