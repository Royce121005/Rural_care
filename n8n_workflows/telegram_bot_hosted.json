      "id": "17",
      "name": "Get Consultations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        350
      ]
    },
    {
      "parameters": {
        "jsCode": "const consultations = $input.item.json.consultations || [];\nconst chatId = $node[\"Extract Command User Data\"].json.chatId;\n\nif (consultations.length === 0) {\n  return {\n    chatId: chatId,\n    text: \"\ud83e\ude7a *Your Consultations*\\n\\nNo upcoming consultations.\\n\\nBook a new consultation:\\n\ud83d\udd17 https://ruralcare-spx6.onrender.com/portal/consultations/new/\"\n  };\n}\n\nlet message = \"\ud83e\ude7a *Your Consultations*\\n\\n\";\n\nconsultations.slice(0, 5).forEach((consult, idx) => {\n  const statusEmoji = {\n    'pending': '\u23f3',\n    'confirmed': '\u2705',\n    'completed': '\u2714\ufe0f',\n    'cancelled': '\u274c'\n  };\n  \n  message += `${idx + 1}. ${statusEmoji[consult.status] || '\ud83d\udccb'} *${consult.doctor_name}*\\n`;\n  message += `   \ud83d\udcc5 ${consult.scheduled_date}\\n`;\n  message += `   \ud83c\udfe5 ${consult.specialization}\\n`;\n  message += `   \ud83d\udccd Status: ${consult.status}\\n`;\n  \n  if (consult.token_id) {\n    message += `   \ud83c\udfab Token: #${consult.token_id}\\n`;\n  }\n  \n  message += \"\\n\";\n});\n\nif (consultations.length > 5) {\n  message += `\\n_...and ${consultations.length - 5} more_\\n`;\n}\n\nmessage += \"\\n\ud83d\udd17 View all: https://ruralcare-spx6.onrender.com/portal/consultations/\";\n\nreturn {\n  chatId: chatId,\n  text: message,\n  parse_mode: \"Markdown\"\n};"
      },
