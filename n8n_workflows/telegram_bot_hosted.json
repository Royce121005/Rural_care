    {
      "parameters": {
        "chatId": "={{$node[\"Extract Command User Data\"].json.chatId}}",
        "text": "=\u2139\ufe0f *RuralCare Telegram Bot - Help*\n\n*\ud83d\udccb Commands:*\n/start - Welcome message\n/link - Link your account\n/consultations - View consultations\n/prescriptions - Track prescriptions\n/dashboard - Get portal links\n/help - Show this help\n\n*\ud83d\udcf8 Image Recognition:*\nSend a photo of any medicine to instantly identify it and get detailed information.\n\n*\ud83c\udfa4 Voice Assistant:*\nSend a voice message with your health question and I'll respond with medical guidance.\n\n*\ud83d\udcac Chat Assistant:*\nJust type any health-related question and I'll help you based on your medical history.\n\n*\ud83d\udd10 Privacy:*\nAll your data is encrypted and HIPAA compliant.\n\n*\ud83c\udd98 Support:*\nFor urgent medical issues, please call emergency services or visit the nearest hospital.\n\n*\ud83c\udf10 Portal:*\nhttps://ruralcare-spx6.onrender.com",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
