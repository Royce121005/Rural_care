    {
      "parameters": {
        "chatId": "={{$node[\"Extract Command User Data\"].json.chatId}}",
        "text": "=\ud83c\udfe5 *Welcome to RuralCare!*\n\nI'm your AI health assistant. I can help you with:\n\n\ud83d\udccb *Medical Services:*\n\u2022 View your consultations and prescriptions\n\u2022 Track your health records\n\u2022 Get medicine information\n\u2022 Ask health questions\n\n\ud83d\udd17 *Getting Started:*\nUse /link to connect your RuralCare account\n\n\ud83d\udca1 *Quick Commands:*\n/consultations - View your consultations\n/prescriptions - Track prescriptions\n/dashboard - Open your dashboard\n/help - Show this message\n\n\ud83d\udcf8 *Smart Features:*\n\u2022 Send a photo of medicine for instant ID\n\u2022 Send voice messages for health queries\n\u2022 Chat with me for medical assistance\n\nHow can I help you today?",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
