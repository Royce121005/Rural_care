      "id": "14",
      "name": "Get Prescriptions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        250
      ]
    },
    {
      "parameters": {
        "jsCode": "const prescriptions = $input.item.json.prescriptions || [];\nconst chatId = $node[\"Extract Command User Data\"].json.chatId;\n\nif (prescriptions.length === 0) {\n  return {\n    chatId: chatId,\n    text: \"\ud83d\udccb *Your Prescriptions*\\n\\nNo active prescriptions found.\\n\\nVisit your dashboard to view prescription history.\\n\\n\ud83d\udd17 https://ruralcare-spx6.onrender.com/portal/prescriptions/\"\n  };\n}\n\nlet message = \"\ud83d\udccb *Your Active Prescriptions*\\n\\n\";\n\nprescriptions.slice(0, 5).forEach((rx, idx) => {\n  message += `${idx + 1}. *${rx.medication_name}*\\n`;\n  message += `   \ud83d\udc8a Dosage: ${rx.dosage}\\n`;\n  message += `   \ud83d\udcc5 Start: ${rx.start_date}\\n`;\n  message += `   \u23f0 Frequency: ${rx.frequency}\\n`;\n  \n  if (rx.delivery_status) {\n    message += `   \ud83d\ude9a Status: ${rx.delivery_status}\\n`;\n  }\n  \n  if (rx.days_remaining) {\n    if (rx.days_remaining <= 3) {\n      message += `   \u26a0\ufe0f Refill needed in ${rx.days_remaining} days!\\n`;\n    } else {\n      message += `   \u23f3 ${rx.days_remaining} days remaining\\n`;\n    }\n  }\n  \n  message += \"\\n\";\n});\n\nif (prescriptions.length > 5) {\n  message += `\\n_...and ${prescriptions.length - 5} more_\\n`;\n}\n\nmessage += \"\\n\ud83d\udd17 View all: https://ruralcare-spx6.onrender.com/portal/prescriptions/\";\n\nreturn {\n  chatId: chatId,\n  text: message,\n  parse_mode: \"Markdown\"\n};"
      },
      "id": "15",
