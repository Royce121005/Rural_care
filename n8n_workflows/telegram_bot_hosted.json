    {
      "parameters": {
        "jsCode": "const chatId = $input.item.json.message.chat.id;\nconst telegramUser = $input.item.json.message.from;\nconst text = $input.item.json.message.text || '';\n\nreturn {\n  chatId: chatId,\n  telegramUserId: telegramUser.id,\n  username: telegramUser.username,\n  firstName: telegramUser.first_name,\n  lastName: telegramUser.last_name,\n  phone: telegramUser.phone_number || null,\n  messageText: text,\n  messageId: $input.item.json.message.message_id,\n  timestamp: new Date().toISOString()\n};"
      },
