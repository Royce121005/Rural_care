    {
      "parameters": {
        "jsCode": "const result = $input.item.json;\nconst chatId = $node[\"Extract Photo Data\"].json.chatId;\n\nif (!result.success) {\n  return {\n    chatId: chatId,\n    text: \"\u274c *Unable to identify medicine*\\n\\nThe image quality might be too low or the medicine is not in our database.\\n\\n\ud83d\udca1 *Tips:*\\n\u2022 Ensure good lighting\\n\u2022 Focus on the medicine name/label\\n\u2022 Try a clearer photo\\n\\nOr search manually: https://ruralcare-spx6.onrender.com/portal/medicine-hub/\",\n    parse_mode: \"Markdown\"\n  };\n}\n\nlet message = `\ud83d\udc8a *${result.medicine_name}*\\n\\n`;\n\nif (result.generic_name) {\n  message += `\ud83d\udd2c Generic: ${result.generic_name}\\n`;\n}\n\nif (result.manufacturer) {\n  message += `\ud83c\udfed Manufacturer: ${result.manufacturer}\\n`;\n}\n\nif (result.category) {\n  message += `\ud83d\udcc2 Category: ${result.category}\\n`;\n}\n\nmessage += \"\\n\";\n\nif (result.uses) {\n  message += `\u2705 *Uses:*\\n${result.uses}\\n\\n`;\n}\n\nif (result.dosage) {\n  message += `\ud83d\udc89 *Dosage:* ${result.dosage}\\n\\n`;\n}\n\nif (result.side_effects) {\n  message += `\u26a0\ufe0f *Side Effects:*\\n${result.side_effects}\\n\\n`;\n}\n\nif (result.precautions) {\n  message += `\ud83d\udea8 *Precautions:*\\n${result.precautions}\\n\\n`;\n}\n\nif (result.confidence) {\n  message += `\ud83c\udfaf Confidence: ${(result.confidence * 100).toFixed(1)}%\\n\\n`;\n}\n\nif (result.interactions && result.interactions.length > 0) {\n  message += \"\u26a0\ufe0f *Drug Interactions Found:*\\n\";\n  result.interactions.forEach(interaction => {\n    message += `\u2022 ${interaction.medication}: ${interaction.description}\\n`;\n  });\n  message += \"\\n\";\n}\n\nmessage += \"\u2695\ufe0f *Note:* Consult your doctor before using any medication.\";\n\nreturn {\n  chatId: chatId,\n  text: message,\n  parse_mode: \"Markdown\"\n};"
      },
