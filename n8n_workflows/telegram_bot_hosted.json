    {
      "parameters": {
        "jsCode": "const messageText = $node[\"Extract Command User Data\"].json.messageText || '';\nconst parts = messageText.trim().split(/\\s+/);\nconst chatId = $node[\"Extract Command User Data\"].json.chatId;\nconst telegramUserId = $node[\"Extract Command User Data\"].json.telegramUserId;\nconst username = $node[\"Extract Command User Data\"].json.username;\n\nif (parts.length > 1) {\n  const phone = parts.slice(1).join('');\n  return {\n    hasPhone: true,\n    chatId: chatId,\n    telegramUserId: telegramUserId,\n    username: username,\n    phone: phone\n  };\n} else {\n  return {\n    hasPhone: false,\n    chatId: chatId,\n    telegramUserId: telegramUserId\n  };\n}"
      },
