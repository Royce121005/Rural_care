    {
      "parameters": {
        "chatId": "={{$node[\"Extract Command User Data\"].json.chatId}}",
        "text": "=\ud83d\udcf1 *Your Dashboard*\n\nAccess your personalized health dashboard:\n\n\ud83d\udd17 https://ruralcare-spx6.onrender.com/portal/health-hub/\n\n*Quick Links:*\n\u2022 Consultations: https://ruralcare-spx6.onrender.com/portal/consultations/\n\u2022 Prescriptions: https://ruralcare-spx6.onrender.com/portal/prescriptions/\n\u2022 Health Records: https://ruralcare-spx6.onrender.com/portal/medical-records/\n\u2022 Treatment Plans: https://ruralcare-spx6.onrender.com/portal/treatment-plan/\n\u2022 Medicine Hub: https://ruralcare-spx6.onrender.com/portal/medicine-hub/\n\n\ud83d\udca1 *Tip:* Bookmark these links for quick access!",
        "additionalFields": {
